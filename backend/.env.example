# --- Server ---
PORT=5000
# The website allowed to call this API (your Vercel address). Leave empty locally.
FRONTEND_URL=

# --- Database (MySQL) ---
DB_NAME=restaurant_db
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_HOST=127.0.0.1
DB_PORT=3306
# Set to true for cloud databases like Aiven
DB_SSL=false

# --- Login tokens ---
JWT_SECRET=any_long_random_string

# --- Email ---
# Inbox that receives contact-form messages
CONTACT_TO=you@example.com
# Option A (on your computer): Gmail with an app password
EMAIL_USER=your_gmail_address@gmail.com
EMAIL_PASS=your_gmail_app_password
# Option B (on Render's free tier, which blocks Gmail): Brevo API key.
# When this is set, Brevo is used instead of Gmail. EMAIL_FROM must be a sender verified in Brevo.
BREVO_API_KEY=
EMAIL_FROM=your_verified_sender@gmail.com
